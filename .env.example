# Endereco da API do LequePlay.
# Enquanto o backend nao sobe, deixe USAR_MOCK=true e o front serve os
# dados de data/midias.json.
API_URL=http://localhost:8080
# Chave da API externa (servidor apenas — NÃO usar o prefixo NEXT_PUBLIC_)
API_KEY=sua_chave_de_api_aqui
USAR_MOCK=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
