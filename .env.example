# Endereco da API do LequePlay.
# Enquanto o backend nao sobe, deixe USAR_MOCK=true e o front serve os
# dados de data/midias.json.
API_URL=http://localhost:8080
USAR_MOCK=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

REVALIDAR_SEGREDO=

# Atraso, em milissegundos, nas actions de marcar como assistida (LP-506).
# So para medir a UI otimista: sem ele, o servidor local responde rapido
# demais para dar para ver se o botao mudou no clique ou na resposta.
# Ignorado em producao (o codigo confere NODE_ENV). Ex.: 1500.
ATRASO_ARTIFICIAL_MS=0

# Recomendacao por IA em /escolher (LP-703). Sem a chave, ou com
# USAR_MOCK=true, a pagina abre e explica que esta desligada.
# A chave so e lida no servidor: nunca use NEXT_PUBLIC_ aqui.
GEMINI_API_KEY=
# Opcional. Padrao: gemini-2.5-flash.
GEMINI_MODELO=
