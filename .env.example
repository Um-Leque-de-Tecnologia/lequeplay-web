# Endereco da API do LequePlay.
# Enquanto o backend nao sobe, deixe USAR_MOCK=true e o front serve os
# dados de data/midias.json.
API_URL=http://localhost:8080
USAR_MOCK=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

REVALIDAR_SEGREDO=

# Se `PUT /v1/midias/{id}/resenha` ja esta no ar.
# Enquanto for diferente de "true", a ficha mostra o campo de escrever com o
# botao desligado e o motivo na tela: o codigo do nosso lado esta pronto
# (app/midias/[slug]/acoes.ts), o endereco da API e que nao existe ainda.
# Conferido: GET /v1/midias/{id}/resenha responde 404 na API publicada.
RESENHA_ENDPOINT_EXISTE=false

# Atraso, em milissegundos, nas actions de marcar como assistida (LP-506).
# So para medir a UI otimista: sem ele, o servidor local responde rapido
# demais para dar para ver se o botao mudou no clique ou na resposta.
# Ignorado em producao (o codigo confere NODE_ENV). Ex.: 1500.
ATRASO_ARTIFICIAL_MS=0
